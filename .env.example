# Copy to .env for local runs. Never commit .env. In GitHub Actions these come from repository Secrets.
ANTHROPIC_API_KEY=sk-ant-...
# Reddit official Data API (free tier). Only needed if the rumor source is enabled.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=athex-agent/0.1 (paper-trading research)
# Hard monthly LLM spend cap across all arms, in EUR.
LLM_MONTHLY_CAP_EUR=25
# 1 = never call the LLM or write state (plumbing checks only)
DRY_RUN=1
